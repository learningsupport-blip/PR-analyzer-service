# Shared with Contributor Conclave. The same value goes in that app as PR_ANALYSIS_TOKEN.
# The browser never receives it. Contributor Conclave sends it as a bearer header.
ANALYSIS_TOKEN=""

# GitHub token used by this service to read the pull request, linked issue, files, and checks.
# A public-repository read token is enough for POST /review. The webhook comment also needs
# permission to read file contents and to create or update issue comments.
# Leave empty to score from the request alone.
GITHUB_TOKEN=""

# Firestore is optional. Leave disabled for local runs.
# On Cloud Run, set FIRESTORE_ENABLED=true and use the runtime service account.
# Do not put a private key in this file.
FIRESTORE_ENABLED=false
FIRESTORE_PROJECT=""
FIRESTORE_COLLECTION=prAnalyses

# rubric keeps the deterministic review. gemini runs the Vertex pipeline and
# falls back to the rubric when the model is unavailable or returns invalid JSON.
ANALYSIS_MODE=rubric
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro
GOOGLE_CLOUD_PROJECT=""
VERTEX_LOCATION=us-central1

# Verifies GitHub pull_request webhooks. The GitHub token above also needs
# permission to read file contents and to create or update issue comments.
GITHUB_WEBHOOK_SECRET=""
